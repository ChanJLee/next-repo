generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Symbol {
  id        Int      @id @default(autoincrement())
  ticker    String   @unique
  name      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  strategies Strategy[]
  signals    StrategySignal[]
  candles    Candle[]
  quote      QuoteCache?
}

// 日线缓存。今日 K 线随盘中变化，updatedAt 控制 TTL；历史日基本不变。
model Candle {
  symbol    Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  symbolId  Int
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  updatedAt DateTime @updatedAt

  @@id([symbolId, date])
  @@index([symbolId, date])
}

// 实时报价缓存，按短 TTL 复用。
model QuoteCache {
  symbol         Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  symbolId       Int      @id
  price          Float
  previousClose  Float
  changePercent  Float
  volume         Float
  marketState    String?
  fetchedAt      DateTime
}

// kind: 见 src/lib/strategies/types.ts StrategyKindEnum
// params: JSON 字符串，按 kind 含不同字段（period/longBelow/shortAbove 等）
// currentLevel: 最新一次评估结果，"long" | "neutral" | "short"
model Strategy {
  id           Int       @id @default(autoincrement())
  symbol       Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  symbolId     Int
  name         String
  kind         String
  params       String    @default("{}")
  cooldownSec  Int       @default(3600)
  enabled      Boolean   @default(true)
  currentLevel String    @default("neutral")
  lastEvalAt   DateTime?
  createdAt    DateTime  @default(now())

  signals StrategySignal[]

  @@index([symbolId])
}

// 一条「转向多」或「转向空」的信号记录（中性不入库）
model StrategySignal {
  id          Int      @id @default(autoincrement())
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyId  Int
  symbol      Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  symbolId    Int
  level       String   // "long" | "short"
  prevLevel   String   // 触发前的级别（含 neutral）
  triggeredAt DateTime @default(now())
  snapshot    String   // JSON 当时的指标快照
  pushed      Boolean  @default(false)
  pushError   String?

  @@index([strategyId, triggeredAt])
  @@index([symbolId, triggeredAt])
}

model Setting {
  key   String @id
  value String
}
