# 本地 SQLite：路径相对 prisma/ 解析，../data → 项目根 data/（先 mkdir -p data 再 pnpm db:push）
DATABASE_URL="file:../data/dev.db"
CRON_SECRET="change-me-to-a-random-string"

# 仅生产（Vercel + Turso）：设置后走 libSQL 连远端；本地留空即用上面的 SQLite
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""
# 可选：Stooq CSV API Key（用于批量回填历史 K 线，免限流）
# 申请：浏览器打开 https://stooq.com/q/d/?s=aapl.us&get_apikey 输入验证码即可拿到 32 位 key
STOOQ_APIKEY=""

# 前端登录凭据（纯前端校验，不写库）。这里只放 SHA-256 哈希，明文不入库不入码。
# 生成（盐固定为 stock-monitor::v1，与 src/lib/auth/client.ts 一致）：
#   node -e 'const c=require("crypto");const s=v=>c.createHash("sha256").update("stock-monitor::v1:"+v).digest("hex");console.log("user",s(process.argv[1]));console.log("pass",s(process.argv[2]))' <用户名> <密码>
# 两个都留空 → 鉴权关闭（本地开发免登录）。
NEXT_PUBLIC_AUTH_USER_HASH=""
NEXT_PUBLIC_AUTH_PASS_HASH=""
